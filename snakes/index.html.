function activate(){
  const code=$('#pw').value.trim().toUpperCase().replace(/\s+/g,'');
  if(!code){showGateMessage('اكتب كود التفعيل أولًا');return;}
  if(code===MASTER_CODE){const a=readActivation();a.permanent=true;a.loggedOut=false;a.activatedAt=Date.now();if(!writeActivation(a)){showGateMessage('تعذر حفظ التفعيل على الجهاز');return;}showGateMessage('تم التفعيل الدائم بنجاح');openGame();return;}
  if(!Object.prototype.hasOwnProperty.call(CODES,code)){showGateMessage('الكود غير صحيح');return;}
  const hours=CODES[code];
  const a=readActivation();a.usedCodes=Array.isArray(a.usedCodes)?a.usedCodes:[];
  if(a.usedCodes.includes(code)){
    if(a.lastCode===code&&rawValid()){a.loggedOut=false;writeActivation(a);showGateMessage('تم الدخول بالتفعيل الحالي');openGame();return;}
    showGateMessage('هذا الكود استُخدم من قبل ولا يمكن استخدامه مرة أخرى');return;}
  a.usedCodes.push(code);a.lastCode=code;a.loggedOut=false;a.activatedAt=Date.now();
  if(hours===0){a.permanent=true;delete a.activeUntil;}
  else{a.permanent=false;a.activeUntil=nowT()+hours*60*60*1000;a.w6=false;a.w5=false;}
  if(!writeActivation(a)){showGateMessage('تعذر حفظ التفعيل على الجهاز');return;}
  showGateMessage(hours===0?'تم التفعيل الدائم بنجاح':(hours===2?'تم التفعيل لمدة ساعتين':'تم التفعيل لمدة 24 ساعة'));openGame();
}
