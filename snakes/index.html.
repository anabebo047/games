 $('#legend').innerHTML='<span><i style="background:var(--cl,#c9a4ff)"></i>حظ</span><span><i style="background:var(--cr,#8bcaff)"></i>إعادة لعب</span><span><i style="background:var(--ct,#ff9baf)"></i>فخ</span><span>🪜 سلم</span><span>🐍 ثعبان</span>';
