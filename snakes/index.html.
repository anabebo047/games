function checkWarn(){
  if($('#gate').classList.contains('hide')===false)return;
  const a=readActivation();if(a.permanent===true)return;
  const left=Number(a.activeUntil)-nowT();if(!(left>0))return;
  let min=0;
  if(left<=300000&&!a.w5){a.w5=true;a.w6=true;min=Math.min(5,Math.max(1,Math.ceil(left/60000)))}
  else if(left<=360000&&left>300000&&!a.w6){a.w6=true;min=6}
  if(min){writeActivation(a);showWarn(min)}
}
