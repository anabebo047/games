function startGame(){
 const N=clampInput('#sN',5,200,40),nT=clampInput('#sT',1,8,4);ensureTD(nT);
 CONFIG.cols=clampInput('#sC',3,12,7);
 G={N,cur:0,lock:false,over:false,used:new Set(),hist:[],cells:{},msgs:{},teams:TD.slice(0,nT).map(d=>({name:d.name||'فريق',pos:0,color:d.color,emoji:d.emoji,img:d.img,snd:d.snd,el:null}))};
 const cL=clampInput('#sLd',0,20,2),cS=clampInput('#sSn',0,20,2),used=new Set();
 const addJ=(a,b)=>{G.cells[a]={type:'jump',to:b};used.add(a);used.add(b)};
 let nl=0,ns=0;
 CONFIG.snakesLadders.filter(x=>x&&x.from>1&&x.from<=N&&x.to>=0&&x.to<=N&&x.to!==x.from).forEach(x=>{if(used.has(x.from)||used.has(x.to))return;if(x.to>x.from){if(nl<cL){addJ(x.from,x.to);nl++}}else if(ns<cS){addJ(x.from,x.to);ns++}});
 for(let t=0;nl<cL&&t<800;t++){const a=2+Math.floor(Math.random()*Math.max(1,N-4)),b=a+3+Math.floor(Math.random()*Math.max(1,N-a-3));if(b<=N-1&&!used.has(a)&&!used.has(b)){addJ(a,b);nl++}}
 for(let t=0;ns<cS&&t<800;t++){const a=5+Math.floor(Math.random()*Math.max(1,N-5)),b=1+Math.floor(Math.random()*Math.max(1,a-3));if(a<=N-1&&b<=a-3&&!used.has(a)&&!used.has(b)){addJ(a,b);ns++}}
 let free=Array.from({length:Math.max(0,N-3)},(_,i)=>i+2).filter(i=>!G.cells[i]&&!used.has(i)).sort(()=>Math.random()-.5);
 [['luck','#sL'],['replay','#sR'],['trap','#sF']].forEach(([type,id])=>{for(let j=0;j<clampInput(id,0,50,0);j++){let c=free.pop();if(c)G.cells[c]={type}}});
 for(let i=1;i<=N;i++)G.msgs[i]=Math.random()<.6?rnd(CONFIG.gifts):rnd(CONFIG.ambushes);
 $('#setup').classList.add('hide');$('#game').classList.remove('hide');$('#hero').classList.remove('hide');document.body.classList.add('playing');build();ui();snd('click')}

