 applyNumStyle();place()}
function ctr(i){const e=G.els[i];return{x:e.offsetLeft+e.offsetWidth/2,y:e.offsetTop+e.offsetHeight/2}}
const SNK=[{a:'#2fb344',b:'#1d8a31',l:'#d9f7ae'},{a:'#ff8a00',b:'#d06200',l:'#ffe5ad'},{a:'#9b4dff',b:'#6c26d6',l:'#e6d0ff'},{a:'#e8334a',b:'#b01c30',l:'#ffd0d6'}];
function ln(x1,y1,x2,y2,w,c,cap){return `<line x1="${x1.toFixed(1)}" y1="${y1.toFixed(1)}" x2="${x2.toFixed(1)}" y2="${y2.toFixed(1)}" stroke="${c}" stroke-width="${w.toFixed(1)}" stroke-linecap="${cap||'round'}"/>`}
function jdefs(W,H){let d=`<defs><filter id="shd" filterUnits="userSpaceOnUse" x="0" y="0" width="${W}" height="${H}"><feDropShadow dx="2" dy="4" stdDeviation="2.4" flood-color="#000" flood-opacity=".5"/></filter><radialGradient id="bolt" cx=".35" cy=".3" r=".8"><stop offset="0" stop-color="#fff"/><stop offset=".45" stop-color="#cfd6e4"/><stop offset="1" stop-color="#5b6577"/></radialGradient>`;
 SNK.forEach((c,i)=>{d+=`<radialGradient id="hg${i}" cx=".35" cy=".3" r=".85"><stop offset="0" stop-color="${c.l}"/><stop offset=".4" stop-color="${c.a}"/><stop offset="1" stop-color="${c.b}"/></radialGradient>`});return d+'</defs>'}
function ladderParts(A,B,cs){const dx=B.x-A.x,dy=B.y-A.y,L=Math.hypot(dx,dy)||1,ux=dx/L,uy=dy/L,nx=-uy,ny=ux,w=cs*.15,e=cs*.14,t=cs*.095;
 const a={x:A.x+ux*e,y:A.y+uy*e},b={x:B.x-ux*e,y:B.y-uy*e},n=Math.max(2,Math.round((L-2*e)/(cs*.34)));
 const dN=(nx*-.55+ny*-.83)>=0?1:-1,lx=nx*dN,ly=ny*dN,dU=(ux*-.55+uy*-.83)>=0?1:-1,kx=ux*dU,ky=uy*dU,ex=cs*.05,ey=cs*.075;
 const rail=(k,c,wd,sx,sy)=>ln(a.x+nx*w*k+sx,a.y+ny*w*k+sy,b.x+nx*w*k+sx,b.y+ny*w*k+sy,wd,c);
 const pt=r=>({x:a.x+(b.x-a.x)*r/n,y:a.y+(b.y-a.y)*r/n});
 const rung=(r,c,wd,sx,sy)=>{const p=pt(r);return ln(p.x-nx*w+sx,p.y-ny*w+sy,p.x+nx*w+sx,p.y+ny*w+sy,wd,c)};
 let sh='',bd='';
 [-1,1].forEach(k=>sh+=rail(k,'#2e1806',t,ex,ey));
 for(let r=0;r<=n;r++)sh+=rung(r,'#2e1806',t*.75,ex,ey);
 for(let r=0;r<=n;r++)bd+=rung(r,'#6b3e14',t*.78,0,0)+rung(r,'#b97a36',t*.55,kx*t*.12,ky*t*.12)+rung(r,'#f0c88a',t*.18,kx*t*.22,ky*t*.22);
 [-1,1].forEach(k=>bd+=rail(k,'#6b3e14',t,0,0)+rail(k,'#c98a43',t*.66,lx*t*.1,ly*t*.1)+rail(k,'#f6d49c',t*.2,lx*t*.22,ly*t*.22));
 for(let r=0;r<=n;r++){const p=pt(r);[-1,1].forEach(k=>bd+=`<circle cx="${(p.x+nx*w*k).toFixed(1)}" cy="${(p.y+ny*w*k).toFixed(1)}" r="${(t*.42).toFixed(1)}" fill="url(#bolt)" stroke="#3a3f4b" stroke-width=".6"/>`)}
 return[sh,bd]}
function snakeParts(A,B,cs,col,ci){const dx=B.x-A.x,dy=B.y-A.y,L=Math.hypot(dx,dy)||1,ux=dx/L,uy=dy/L,nx=-uy,ny=ux;
 const waves=Math.max(1.5,L/(cs*1.5)),amp=cs*.3,S=Math.min(80,Math.max(24,Math.round(L/(cs*.12)))),P=[];
 for(let k=0;k<=S;k++){const t=k/S,off=Math.sin(t*waves*Math.PI*2)*amp*(.35+.65*Math.sin(Math.PI*t));P.push({x:A.x+dx*t+nx*off,y:A.y+dy*t+ny*off,w:cs*(.30-.23*t)})}
 const seg=(k,sx,sy,wd,c)=>ln(P[k].x+sx,P[k].y+sy,P[k+1].x+sx,P[k+1].y+sy,wd,c);
 let sh='',bd='';
 for(let k=0;k<S;k++)sh+=seg(k,0,0,P[k].w+cs*.07,'#0b2214');
 for(let k=0;k<S;k++)bd+=seg(k,0,0,P[k].w,(Math.floor(k/3)%2)?col.b:col.a);
 for(let k=3;k<S-2;k+=6)bd+=`<circle cx="${P[k].x.toFixed(1)}" cy="${P[k].y.toFixed(1)}" r="${(P[k].w*.2).toFixed(1)}" fill="#000" opacity=".28"/>`;
 bd+='<g opacity=".4">';for(let k=0;k<S;k++)bd+=seg(k,P[k].w*.2,P[k].w*.27,P[k].w*.32,'#000');
 bd+='</g><g opacity=".55">';for(let k=0;k<S;k++)bd+=seg(k,-P[k].w*.17,-P[k].w*.24,P[k].w*.34,col.l);
 bd+='</g><g opacity=".6">';for(let k=0;k<S;k++)bd+=seg(k,-P[k].w*.22,-P[k].w*.3,P[k].w*.1,'#fff');bd+='</g>';
 const ang=Math.atan2(P[0].y-P[1].y,P[0].x-P[1].x)*180/Math.PI,u=cs,tr=`translate(${A.x.toFixed(1)} ${A.y.toFixed(1)}) rotate(${ang.toFixed(1)})`;
 sh+=`<ellipse transform="${tr}" rx="${u*.27}" ry="${u*.21}" fill="#0b2214"/>`;
 const eye=y=>`<circle cx="${u*.07}" cy="${y*u*.11}" r="${u*.065}" fill="#fffbd0" stroke="#0b2214" stroke-width="${u*.015}"/><ellipse cx="${u*.09}" cy="${y*u*.11}" rx="${u*.022}" ry="${u*.045}" fill="#111"/><circle cx="${u*.075}" cy="${y*u*.125}" r="${u*.012}" fill="#fff"/>`;
 bd+=`<g transform="${tr}"><path d="M${u*.22} 0 L${u*.46} 0 M${u*.46} 0 L${u*.55} ${-u*.07} M${u*.46} 0 L${u*.55} ${u*.07}" stroke="#ff2b3d" stroke-width="${u*.035}" fill="none" stroke-linecap="round"/><ellipse rx="${u*.27}" ry="${u*.21}" fill="url(#hg${ci})" stroke="#0b2214" stroke-width="${u*.04}"/><ellipse cx="${u*.02}" cy="${-u*.08}" rx="${u*.15}" ry="${u*.05}" fill="#fff" opacity=".35"/>${eye(-1)}${eye(1)}<path d="M${-u*.01} ${-u*.18} L${u*.13} ${-u*.13} M${-u*.01} ${u*.18} L${u*.13} ${u*.13}" stroke="#0b2214" stroke-width="${u*.03}" stroke-linecap="round"/><circle cx="${u*.22}" cy="${-u*.05}" r="${u*.013}" fill="#0b2214"/><circle cx="${u*.22}" cy="${u*.05}" r="${u*.013}" fill="#0b2214"/></g>`;
 return[sh,bd]}
function drawJumps(){if(!G||!G.els||!G.els.length)return;const b=$('#board'),svg=$('#jumps');if(!svg)return;const W=b.clientWidth,H=b.clientHeight;if(!W)return;
 svg.setAttribute('viewBox',`0 0 ${W} ${H}`);const cs=G.els[0].offsetWidth;let sh='',bd='',si=0;
 Object.keys(G.cells).forEach(k=>{const c=G.cells[k];if(c.type!=='jump')return;const A=ctr(+k),B=ctr(c.to);
  if(c.to>+k){const p=ladderParts(A,B,cs);sh+=p[0];bd+=`<g class="lad">${p[1]}</g>`}else{const ci=si++%SNK.length,p=snakeParts(A,B,cs,SNK[ci],ci);sh+=p[0];bd+=`<g class="snk">${p[1]}</g>`}});
 svg.innerHTML=jdefs(W,H)+`<g filter="url(#shd)">${sh}</g>`+bd}
function place(){if(!G||!G.els)return;const bd=$('#board');if(bd.clientWidth!==G.bw){G.bw=bd.clientWidth;drawJumps()}G.els.forEach(e=>e.classList.remove('occ'));G.teams.forEach((t,i)=>{let c=G.els[t.pos];if(!c||!t.el)return;c.classList.add('occ');let s=c.offsetWidth*.55,dx=(i-(G.teams.length-1)/2)*c.offsetWidth*.12;Object.assign(t.el.style,{width:s+'px',height:s+'px',fontSize:s*.6+'px',left:c.offsetLeft+(c.offsetWidth-s)/2+dx+'px',top:c.offsetTop+(c.offsetHeight-s)/2+'px'})})}
window.addEventListener('resize',()=>place());try{new ResizeObserver(()=>place()).observe($('#board'))}catch(e){}
function avatar(t){return t.img?`<span style="display:inline-block;width:24px;height:24px;border-radius:50%;vertical-align:middle;background:url('${t.img}') center/cover"></span>`:t.emoji}
function ui(){if(!G)return;$('#bar').innerHTML=G.teams.map((t,i)=>`<div class="team-pill ${i===G.cur?'on':''}" style="background:${t.color}">${avatar(t)} ${esc(t.name)} · ${t.pos}</div>`).join('');let t=G.teams[G.cur];$('#turn').innerHTML=`${avatar(t)} دور <span style="color:${t.color};filter:brightness(1.5)">${esc(t.name)}</span> ▶`}
async function moveTo(t,target){target=Math.max(0,Math.min(G.N+1,target));let a=t.snd?new Audio(t.snd):null;if(a&&!muted){a.volume=.9;a.play().catch(()=>{});setTimeout(()=>{a.pause();a.currentTime=0},15000)}
 while(t.pos!==target){t.pos+=t.pos<target?1:-1;place();if(!a)snd('step');await sleep(230)}ui()}
async function pick(n){if(!G||G.lock||G.over||G.used.has(n))return;
 G.hist.push({pos:G.teams.map(t=>t.pos),cur:G.cur,used:[...G.used],msgs:{...G.msgs}});
 G.lock=true;G.used.add(n);$('#n'+n).disabled=true;let t=G.teams[G.cur],k=G.msgs[n];
 snd(k.m>=0?'gift':'ambush');
