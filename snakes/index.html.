  <div class="ns-shapes">${sh.map(([k,t])=>`<button data-s="${k}" class="${numStyle.shape===k?'on':''}">${t}</button>`).join('')}</div>
  <div class="ns-prev" id="nsPrev" style="--nimg:${numStyle.img?`url(&quot;${numStyle.img}&quot;)`:'none'}">${[1,2,3,4,5,6].map(n=>`<button class="n ${numClass()}">${n}</button>`).join('')}</div>
  <div class="ns-row"><label>🖼️ إضافة صورة<input type="file" id="nsImg" accept="image/*" hidden></label><button id="nsClr">🗑 حذف الصورة</button></div>
  <button class="go" id="nsOk">تم</button></div>`;
  m.classList.add('on');
  m.querySelectorAll('[data-s]').forEach(b=>b.onclick=()=>{numStyle.shape=b.dataset.s;applyNumStyle();saveSettings(true);draw()});
  $('#nsImg').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{numStyle.img=await shrinkImg(f);applyNumStyle();saveSettings(true);draw()}catch(_){toast('تعذر تحميل الصورة')}};
  $('#nsClr').onclick=()=>{numStyle.img='';applyNumStyle();saveSettings(true);draw()};
  $('#nsOk').onclick=()=>m.classList.remove('on');
 };draw();
}
$('#numStyleBtn').onclick=numStyleEditor;$('#numStyleBtn2').onclick=numStyleEditor;


// ---- ألوان وثيم ----
function themeEditor(){
 const m=$('#modal');if(m.classList.contains('on'))return toast('أكمل الخطوة الحالية أولًا');
 $('#settingsDrawer').classList.add('hide');$('#settingsToggle').classList.remove('on');
 const PR=[['🌈 الأساسي',{}],['⚫ أسود/أبيض',{c1:'#0b0b0b',c2:'#1c1c1c',tx:'#ffffff',cb:'#555555',nb:'#111111',nt:'#ffffff',nbd:'#ffffff',fr:'#000000'}],['⚪ أبيض/أسود',{c1:'#ffffff',c2:'#e9edf5',tx:'#111111',cb:'#9aa6b8',nb:'#ffffff',nt:'#111111',nbd:'#111111',fr:'#c9d3e6'}],['💜 نيون',{c1:'#1b0a3c',c2:'#2a1260',tx:'#7af0ff',cb:'#7a3bff',nb:'#12062e',nt:'#7af0ff',nbd:'#ff4fd0',fr:'#0a0420'}],['🌿 أخضر',{c1:'#1f7a3a',c2:'#2fa653',tx:'#ffffff',cb:'#d6ffe0',nb:'#0e4a22',nt:'#ffffff',nbd:'#9dffb8',fr:'#0b3a1a'}],['🥇 ذهبي',{c1:'#2b2000',c2:'#4a3600',tx:'#ffd54a',cb:'#ffd54a',nb:'#2b2000',nt:'#ffd54a',nbd:'#ffd54a',fr:'#1a1300'}],['🌊 أزرق',{c1:'#14357a',c2:'#2457c8',tx:'#ffffff',cb:'#a8c8ff',nb:'#0b2358',nt:'#ffffff',nbd:'#7fb2ff',fr:'#061c4a'}]];
 const R1=[['c1','لون المربع ١'],['c2','لون المربع ٢'],['tx','لون الرقم'],['cb','حدود المربعات'],['cl','مربع الحظ'],['cr','مربع الإعادة'],['ct','مربع الفخ'],['fr','إطار اللوحة']];
 const R2=[['nb','خلفية الزر'],['nt','لون الرقم'],['nbd','حدود الزر']];
 const cp=([k,t])=>`<label class="cp"><span>${t}</span><input type="color" data-k="${k}" value="${TH[k]||TH_SHOW[k]}"></label>`;
 const draw=()=>{
  m.classList.add('theme');
  m.innerHTML=`<div class="box th"><h3>🎨 ألوان وثيم اللعبة</h3>
  <div class="thp">${PR.map((p,i)=>`<button data-p="${i}">${p[0]}</button>`).join('')}</div>
  <div class="thprev"><div class="cell a"><b class="cn">12</b></div><div class="cell b"><b class="cn">13</b></div><div class="cell luck"><b class="cn">14</b></div><div class="cell trap"><b class="cn">15</b></div><button class="n ${numClass()}">1</button><button class="n ${numClass()}">2</button></div>
  <div class="ths">المربعات</div><div class="thg">${R1.map(cp).join('')}</div>
  <div class="ths">أزرار الاختيار تحت اللوحة</div><div class="thg">${R2.map(cp).join('')}</div>
  <div class="ths">حجم رقم المربع</div><div class="ns-row"><button id="nsM">🔡 −</button><b id="nsV" class="nsv">${Math.round((TH.ns||1)*100)}%</b><button id="nsP">🔠 +</button></div>
  <div class="ns-row"><button id="thReset">↺ الأساسي</button><button class="go" id="thOk">تم</button></div></div>`;
  m.querySelectorAll('[data-p]').forEach(b=>b.onclick=()=>{const ns=TH.ns;TH=Object.assign({},TH_DEF,PR[+b.dataset.p][1],{ns});applyTheme();saveSoon();draw()});
  m.querySelectorAll('input[type=color]').forEach(i=>i.oninput=()=>{TH[i.dataset.k]=i.value;applyTheme();saveSoon()});
  $('#nsM').onclick=()=>bumpNs(-.15);$('#nsP').onclick=()=>bumpNs(.15);
  $('#thReset').onclick=()=>{TH=Object.assign({},TH_DEF);applyTheme();saveSoon();draw()};
  $('#thOk').onclick=()=>{m.classList.remove('on','theme');saveSettings(true)};
 };m.classList.add('on');draw();
}
$('#themeBtn').onclick=themeEditor;$('#themeBtn2').onclick=themeEditor;
$('#nsUp').onclick=()=>bumpNs(.15);$('#nsDown').onclick=()=>bumpNs(-.15);
applyTheme();

// ---- منع تحديث الصفحة بسحب الشاشة لأسفل ----
(function(){let sy=0;
 document.addEventListener('touchstart',e=>{if(e.touches.length)sy=e.touches[0].clientY},{passive:true});
 document.addEventListener('touchmove',e=>{
  if(e.touches.length!==1)return;if(e.touches[0].clientY-sy<=0)return;
  let el=e.target;
  while(el&&el!==document.body&&el!==document.documentElement){
   if(el.scrollHeight>el.clientHeight+1&&el.scrollTop>0){const oy=getComputedStyle(el).overflowY;if(oy==='auto'||oy==='scroll')return}
   el=el.parentElement}
  if((window.scrollY||document.documentElement.scrollTop||0)<=0&&e.cancelable)e.preventDefault();
 },{passive:false});
})();
setBg();
document.addEventListener('visibilitychange',()=>{if(!document.hidden){tickClock();updateActivationTimer();checkWarn()}});
// تحميل الإعدادات المحفوظة عند تشغيل التطبيق
loadSettings();
</script>
