<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>السلم والتعبان</title>
<style>
*{box-sizing:border-box;margin:0}
html{background:#030b25}
body{font-family:Tahoma,Arial,sans-serif;min-height:100vh;color:#fff;padding:6px 10px 74px;overflow-x:hidden;background:#061b53;position:relative}
button,input,select,textarea{font:inherit}button{cursor:pointer}
.hide{display:none!important}
img{-webkit-user-drag:none;user-select:none}

/* decor corners (cut from the reference image) */
.dec{position:fixed;pointer-events:none;z-index:0}
.dLT{left:0;top:0;width:clamp(34px,6vw,76px);-webkit-mask-image:radial-gradient(ellipse 100% 100% at 0 0,#000 55%,transparent 100%);mask-image:radial-gradient(ellipse 100% 100% at 0 0,#000 55%,transparent 100%)}
.dRT{right:0;top:0;width:clamp(30px,5.5vw,70px);-webkit-mask-image:radial-gradient(ellipse 100% 100% at 100% 0,#000 55%,transparent 100%);mask-image:radial-gradient(ellipse 100% 100% at 100% 0,#000 55%,transparent 100%)}
.dLB{left:0;bottom:0;width:clamp(56px,10vw,135px);-webkit-mask-image:radial-gradient(ellipse 100% 100% at 0 100%,#000 55%,transparent 100%);mask-image:radial-gradient(ellipse 100% 100% at 0 100%,#000 55%,transparent 100%)}
.dRB{right:0;bottom:0;width:clamp(44px,8vw,110px);-webkit-mask-image:radial-gradient(ellipse 100% 100% at 100% 100%,#000 55%,transparent 100%);mask-image:radial-gradient(ellipse 100% 100% at 100% 100%,#000 55%,transparent 100%)}
#gate,#toolbar,#settingsDrawer,#hero,#setup,#game{position:relative;z-index:2}

/* lock screen */
#gate{position:fixed;inset:0;z-index:100;background:radial-gradient(ellipse at 50% 25%,#1f4fb5,#061744 60%,#020816);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:14px;padding:20px;text-align:center}
#gate .glogo{width:min(520px,92vw);-webkit-mask-image:radial-gradient(ellipse 75% 85% at 50% 50%,#000 55%,transparent 100%);mask-image:radial-gradient(ellipse 75% 85% at 50% 50%,#000 55%,transparent 100%)}
#gate p{font-weight:bold;color:#cfeaff}
#pw{width:min(290px,90vw);padding:14px;border:3px solid #ffc52e;border-radius:16px;text-align:center;letter-spacing:6px;color:#082d68;background:#eaf8ff;font-weight:900;font-size:1.1rem}
.go{background:linear-gradient(#ffe65a,#ffb300 55%,#ff8a00);color:#632700;border:3px solid #fff1a8;border-radius:30px;padding:12px 30px;font-weight:900;font-size:1.2rem;box-shadow:0 5px 0 #9c4c00,0 0 18px #ffb00088;text-shadow:0 1px #fff7}
.go:active{transform:translateY(3px);box-shadow:0 2px 0 #9c4c00}
#gate .gcredit{position:absolute;bottom:14px;display:flex;align-items:center;gap:10px;direction:ltr;white-space:nowrap}


/* hero */
.hero{position:relative;max-width:1050px;margin:0 auto;aspect-ratio:1050/250}
.hp{position:absolute;top:0;-webkit-mask-image:radial-gradient(ellipse closest-side at 50% 50%,#000 62%,transparent 100%);mask-image:radial-gradient(ellipse closest-side at 50% 50%,#000 62%,transparent 100%)}
.hw{left:-3%;width:37%}.hm{right:-3%;width:37%}
.hl{left:50%;transform:translateX(-50%);width:52%;z-index:2;-webkit-mask-image:linear-gradient(to right,transparent,#000 6%,#000 94%,transparent),linear-gradient(to bottom,#000 80%,transparent);-webkit-mask-composite:source-in;mask-image:linear-gradient(to right,transparent,#000 6%,#000 94%,transparent),linear-gradient(to bottom,#000 80%,transparent);mask-composite:intersect}
#titleTxt{position:absolute;left:50%;top:0;height:100%;transform:translateX(-50%);z-index:3;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;-webkit-mask-image:none;mask-image:none;width:60%;text-align:center}
#titleTxt .cr{font-size:clamp(1.6rem,6vw,3.2rem);filter:drop-shadow(0 3px 0 #8a4a00);line-height:1}
#titleTxt h1{font-size:clamp(2rem,8vw,4.4rem);line-height:1.2;background:linear-gradient(90deg,#fff3a0,#ffc21e,#ff7ad9,#7af0ff,#fff3a0);background-size:250% 100%;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;animation:glowName 3.2s linear infinite,titleGlow 1.8s ease-in-out infinite alternate}
body.playing .hero{aspect-ratio:auto;height:clamp(64px,13vw,120px)}
body.playing .hw,body.playing .hm{display:none}
body.playing .hl{width:auto;height:100%}

/* glow behind logo + wizard polish */
.hero::before{content:"";position:absolute;left:50%;top:50%;width:62%;height:78%;transform:translate(-50%,-50%);z-index:0;border-radius:50%;background:conic-gradient(from 0deg,#ffc21e,#ff4fd0,#4fe3ff,#8f6bff,#ffc21e);filter:blur(34px);opacity:.55;animation:spinGlow 7s linear infinite;pointer-events:none}
@keyframes spinGlow{to{transform:translate(-50%,-50%) rotate(360deg)}}
.hl{animation:logoPulse 2.2s ease-in-out infinite alternate}
@keyframes logoPulse{from{filter:brightness(1) saturate(1.05)}to{filter:brightness(1.22) saturate(1.35)}}
@keyframes titleGlow{from{filter:drop-shadow(0 0 3px #ffc21e) drop-shadow(0 3px 0 #8a3b00)}to{filter:drop-shadow(0 0 12px #ffc21e) drop-shadow(0 0 22px #ff7ad9) drop-shadow(0 3px 0 #8a3b00)}}
.hw{-webkit-mask-image:radial-gradient(ellipse closest-side at 50% 50%,#000 80%,transparent 100%);mask-image:radial-gradient(ellipse closest-side at 50% 50%,#000 80%,transparent 100%);animation:floaty 4s ease-in-out infinite;image-rendering:auto}
@keyframes floaty{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
body.playing .hero::before{width:40%}

/* setup panel */
.panel{max-width:1050px;margin:20px auto 12px;padding:clamp(30px,6vw,40px) clamp(10px,3vw,24px) clamp(14px,3vw,24px);border:3px solid #62ddff;border-radius:28px;background:linear-gradient(160deg,#2b92d8f2,#1769b4f2 45%,#0f4a95f2);box-shadow:0 0 0 5px #0a2a68,0 0 0 7px #3bc6ff,0 14px 34px #000a,inset 0 0 30px #8ff1ff66;position:relative}
.panel-title{position:absolute;top:-24px;left:50%;transform:translateX(-50%);white-space:nowrap;display:flex;align-items:center;gap:10px;padding:7px 28px;border:3px solid #ffce38;border-radius:20px;background:linear-gradient(#173f8c,#071b58);font-size:1.2rem;font-weight:900;text-shadow:0 2px #000;box-shadow:0 4px 10px #0009,inset 0 0 12px #3b8dff88}
.panel-title img{height:28px;mix-blend-mode:lighten}
.settings-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:10px}
.settings-grid .field{grid-column:span 3}
.settings-grid .field.w4{grid-column:span 4}
.field{display:flex;flex-direction:column;gap:7px;padding:9px 10px;border-radius:16px;border:2px solid #9fe3ff;background:linear-gradient(#f6fdff,#bfe8ff);color:#082e69;box-shadow:inset 0 2px 7px #fff,0 3px 0 #0b5aa3}
.field label{font-weight:900;font-size:.92rem;display:flex;align-items:center;gap:6px}
.field label img{height:28px;mix-blend-mode:multiply}
.field input{width:100%;min-width:0;border:2px solid #7fc8f6;border-radius:11px;padding:7px;text-align:center;background:#dff3ff;color:#07366b;font-weight:900;font-size:1.15rem}
.teams-title{margin:20px auto 0;text-align:center;background:linear-gradient(#0e45a0,#082e72);border:2px solid #4fb7f0;border-radius:22px;padding:7px 15px;max-width:540px;font-weight:900;position:relative;top:14px;z-index:1;box-shadow:0 3px 8px #0007}
.teams-wrap{border:2px solid #9fe3ff;border-radius:20px;padding:24px 10px 10px;background:linear-gradient(#e3f6ff,#b5e2ff);box-shadow:inset 0 0 14px #fff}
.teams-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}
.team-card{background:linear-gradient(#f9fdff,#d8efff);border:3px solid var(--team);border-radius:18px;color:#092f6a;padding:8px;min-width:0;box-shadow:0 3px 0 #0a4c92}
.tc-top{display:flex;align-items:center;gap:8px}
.team-avatar{width:58px;height:58px;flex:none;border-radius:50%;border:3px solid var(--team);background:radial-gradient(#fff,#d6ecff);display:flex;align-items:center;justify-content:center;font-size:2rem;overflow:hidden;box-shadow:0 2px 5px #0005}
.team-avatar img{width:100%;height:100%;object-fit:cover}
.tc-info{flex:1;min-width:0}
.tc-name{display:flex;align-items:center;gap:3px;justify-content:space-between}
.tc-name input{flex:1;width:100%;min-width:0;border:0;background:transparent;color:#082e69;font-weight:900;padding:2px;font-size:.92rem}
.tc-name span{font-size:.85rem;color:#1a5fb8}
.pill{display:block;width:80%;margin:2px auto 0;height:24px;border-radius:14px;overflow:hidden}
.pill input{width:100%;height:100%;border:0;padding:0;cursor:pointer;background:none;-webkit-appearance:none;appearance:none;border-radius:14px}
.pill input::-webkit-color-swatch-wrapper{padding:0}.pill input::-webkit-color-swatch{border:2px solid #fff8;border-radius:14px;box-shadow:inset 0 3px 4px #fff7}
.tc-row{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;margin-top:8px;align-items:center}
.tc-row>*{min-width:0}
.tc-row select{width:100%;border:0;border-radius:50%;background:#ffe27a;font-size:1.1rem;height:32px;padding:0;text-align:center;-webkit-appearance:none;appearance:none}
.dot{width:26px;height:26px;border-radius:50%;border:2px solid #fff;box-shadow:0 0 0 1px #0004;margin:auto;overflow:hidden;position:relative}
.dot input{position:absolute;inset:-6px;width:40px;height:40px;opacity:0;cursor:pointer}
.mbtn{display:flex;align-items:center;justify-content:center;height:32px;border-radius:9px;background:linear-gradient(#e9f7ff,#bfe3fb);border:2px solid #5db4ee;color:#0a3c80;font-size:1rem;cursor:pointer}
.mbtn input{display:none}
.tc-clear{display:flex;gap:5px;margin-top:5px}
.tc-clear button{flex:1;font-size:.68rem;border:1px solid #8cc7ee;border-radius:8px;background:#e9f6ff;color:#2a5a95;padding:3px}
.tc-note{display:block;text-align:center;margin-top:3px;font-size:.62rem;color:#2a5a95}
.bg-title{width:max-content;margin:16px auto -12px;position:relative;z-index:1;background:linear-gradient(#e6f7ff,#b3e0ff);color:#0a3c7e;border:2px solid #7ecbf5;border-radius:16px;padding:4px 22px;font-weight:900}
.bg-row{display:flex;gap:9px;justify-content:center;flex-wrap:wrap;padding:20px 12px 12px;border-radius:16px;background:linear-gradient(#e6f7ff,#b9e3ff);border:2px solid #8fd3fa;max-width:760px;margin:0 auto}
.bg-chip{width:62px;height:42px;border-radius:9px;border:3px solid #fff;box-shadow:0 3px 0 #06356e;background-size:cover;background-position:center}
.bg-chip.on{outline:3px solid #ffce38;outline-offset:1px}
.actions{display:flex;flex-direction:column;justify-content:center;align-items:center;gap:12px;margin-top:16px}
.actions .go{justify-self:center;padding:12px 34px;font-size:1.25rem;min-width:230px}
.nbtn{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;max-width:230px;border:3px solid #35bfff;border-radius:26px;background:linear-gradient(#0d3f95,#06235e);color:#fff;padding:9px 14px;font-weight:900;font-size:1rem;box-shadow:0 3px 0 #031a45,inset 0 0 12px #3aa7ff77}
.nbtn img{height:30px;mix-blend-mode:lighten}
.nbtn.r{justify-self:end}.nbtn.l{justify-self:start}
.secondary{border:2px solid #4fd0ff;border-radius:26px;background:linear-gradient(#1763b7,#08255f);color:#fff;padding:11px 16px;font-weight:900;box-shadow:0 3px 0 #031a45,inset 0 0 10px #3aa7ff66}

/* settings tab (transparent until tapped) */
#toolbar{position:fixed;left:0;top:40%;z-index:60;touch-action:none;user-select:none;-webkit-user-select:none}
#settingsToggle{border:0;background:transparent;padding:0;opacity:.2;transition:opacity .25s;display:block;line-height:0;touch-action:none}
#settingsToggle img{width:58px;display:block}
#settingsToggle.on{opacity:1;filter:drop-shadow(0 4px 8px #000a)}
#settingsDrawer{position:fixed;top:12%;left:8px;width:min(164px,calc(100vw - 16px));z-index:90;padding:3px 4px;background:#0a1f55f2;border:1px solid #53dfff99;border-radius:12px;box-shadow:0 6px 20px #000b;max-height:72vh;overflow:auto;overscroll-behavior:contain}
#settingsDrawer button{display:flex;align-items:center;gap:6px;width:100%;margin:0;padding:7px 8px;border:0;border-bottom:1px solid #ffffff18;border-radius:0;background:transparent;color:#e8f6ff;font-size:.76rem;font-weight:700;text-align:right;box-shadow:none;text-shadow:none}
#settingsDrawer button:active{background:#ffffff26;transform:none}
#settingsDrawer #closeDrawer{border-bottom:0;color:#ffd978}
#settingsDrawer #activationTimer{margin:4px 2px;padding:5px;border:1px solid #53dfff66;border-radius:8px;text-align:center;font-size:.7rem;font-weight:700;color:#bfefff}

/* game */
#boardWrap{max-width:680px;margin:12px auto;background:linear-gradient(#0d4c82,#061c4a);border:2px solid #4ed9ff;border-radius:18px;padding:10px;box-shadow:0 0 22px #00bfff55}
#board{position:relative;display:grid;grid-template-columns:repeat(var(--cols),minmax(0,1fr));gap:5px;direction:rtl}
.cell{aspect-ratio:1;border-radius:8px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#082d62;font-weight:900;font-size:clamp(.65rem,2.4vw,1rem);box-shadow:inset 0 0 0 1px #fff8}
.cell small{font-size:.65em}.cell.a{background:#ffe66d}.cell.b{background:#8beaff}.cell.start{background:#75efaa}.cell.end{background:#ffad78}.cell.luck{background:#c9a4ff}.cell.replay{background:#8bcaff}.cell.trap{background:#ff9baf}.cell.jump{background:#b8f29d}
.tok{position:absolute;border-radius:50%;display:flex;align-items:center;justify-content:center;border:3px solid;background:#fff;z-index:3;pointer-events:none;transition:left .2s,top .2s;box-shadow:0 2px 5px #0008}
#bar{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin:10px auto}
.team-pill{padding:8px 13px;border-radius:12px;font-weight:900;opacity:.65;border:2px solid #fff8}.team-pill.on{opacity:1;transform:scale(1.05);box-shadow:0 0 0 3px #ffdf48}
#turn{text-align:center;margin:8px auto;max-width:680px;background:#062653;border:1px solid #42d9ff;border-radius:12px;padding:10px;font-weight:900}
#pick{text-align:center;max-width:900px;margin:10px auto}
#nums{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin-top:9px}
.n{width:42px;height:42px;border-radius:50%;border:2px solid #00e5ff;background:#082c61;color:#8ff5ff;font-weight:900;font-size:1rem;touch-action:manipulation}
.n:disabled{opacity:.25}
#modal{position:fixed;inset:0;background:#000b;display:none;align-items:center;justify-content:center;z-index:120;padding:14px}
#modal.on{display:flex}.box{background:linear-gradient(#163b78,#151b45);border:2px solid #00dfff;border-radius:20px;padding:20px;max-width:450px;width:100%;text-align:center;box-shadow:0 0 30px #00bfff55}.box h3{color:#ffdc4c;margin-bottom:12px}.num{font-size:2rem;color:#00efff;font-weight:900;margin:8px}.msg{line-height:1.8;margin:10px 0}.box .go{margin:6px}
.cards{display:flex;gap:10px;justify-content:center;margin:15px}.cd{width:70px;height:95px;border-radius:12px;background:#304b82;border:2px solid #00dfff;display:flex;align-items:center;justify-content:center;font-size:2.3rem;color:#fff}
#toast{position:fixed;top:12px;left:50%;transform:translateX(-50%);background:#10b981;padding:10px 18px;border-radius:12px;z-index:140;display:none;font-weight:900}
textarea{width:100%;height:260px;direction:ltr;font:12px monospace;background:#111;color:#8f8;padding:8px;border-radius:8px}

/* credit */
#credit{position:fixed;bottom:6px;left:50%;transform:translateX(-50%);z-index:70;display:flex;align-items:center;gap:9px;padding:6px 20px;background:linear-gradient(#10286f,#071447);border:2px solid #d9a21e;border-radius:6px 6px 22px 22px;white-space:nowrap;box-shadow:0 0 16px #000a,0 0 14px #ffb30044;direction:ltr;max-width:96vw}
#credit i{color:#e3a928;font-style:normal}
.cname{font-weight:900;letter-spacing:.5px;background:linear-gradient(90deg,#fff3a0,#ffc21e,#ff7ad9,#7af0ff,#fff3a0);background-size:250% 100%;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;animation:glowName 3.2s linear infinite,pulseGlow 1.8s ease-in-out infinite alternate}
.csep{color:#ffd54a;text-shadow:0 0 8px #ffb300}
.cphone{pointer-events:none;-webkit-user-select:none;user-select:none;font-weight:900;color:#8ff5ff;text-decoration:none;letter-spacing:1px;text-shadow:0 0 6px #19c4ff,0 0 14px #19c4ff88;border:1px solid #53dfff88;border-radius:12px;padding:1px 9px;background:#0a2a6a99}
@keyframes glowName{to{background-position:250% 0}}
@keyframes pulseGlow{from{filter:drop-shadow(0 0 2px #ffc21e)}to{filter:drop-shadow(0 0 9px #ffc21e) drop-shadow(0 0 16px #ff7ad9)}}
@media(max-width:420px){#credit{padding:5px 10px;gap:6px;font-size:.78rem}#credit i{display:none}.cphone{padding:1px 6px}}

@media(max-width:760px){
 .hero{aspect-ratio:390/118}
 .hw,.hm{width:40%}.hl{width:58%}
 .settings-grid .field,.settings-grid .field.w4{grid-column:span 6}
 .settings-grid .field.w4:last-child{grid-column:span 12}
 .teams-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
 .nbtn{max-width:none}
 body.playing .hero{height:clamp(56px,16vw,90px)}
}
@media(max-width:390px){body{padding-inline:6px}.panel{padding-inline:8px}.field label{font-size:.78rem}.team-avatar{width:46px;height:46px;font-size:1.6rem}.tc-name input{font-size:.8rem}.nbtn{font-size:.85rem}}

/* حركات ناعمة */
#warnLayer{position:fixed;inset:0;pointer-events:none;z-index:160}
.warn-bubble{position:absolute;top:16%;left:50%;transform:translateX(-50%);animation:wbIn .55s cubic-bezier(.2,1.4,.4,1) both}
.warn-bubble .wb-in{display:flex;align-items:center;gap:8px;padding:14px 24px;border-radius:999px;font-weight:900;font-size:1rem;color:#fff;text-align:center;white-space:nowrap;
 background:radial-gradient(circle at 30% 25%,#ffffffcc 0,#ffffff22 18%,transparent 19%),linear-gradient(145deg,#2b8fff,#7a3bff);border:2px solid #ffffffaa;box-shadow:0 0 22px #53dfffaa,0 0 40px #8f6bff88,inset 0 -8px 16px #00000040,inset 0 6px 12px #ffffff55;text-shadow:0 1px 3px #0008;animation:wbFloat 1.6s ease-in-out infinite alternate}
.warn-bubble .wb-ic{font-size:1.4rem}.warn-bubble b{color:#ffe65a;font-size:1.25rem}
.warn-bubble.pop{animation:wbPop .35s ease-out forwards}
@keyframes wbIn{from{opacity:0;transform:translateX(-50%) scale(.2)}to{opacity:1;transform:translateX(-50%) scale(1)}}
@keyframes wbFloat{from{transform:translateY(-4px)}to{transform:translateY(5px)}}
@keyframes wbPop{0%{transform:translateX(-50%) scale(1);opacity:1}45%{transform:translateX(-50%) scale(1.25);opacity:1}100%{transform:translateX(-50%) scale(1.6);opacity:0}}
.wb-dot{position:fixed;width:9px;height:9px;border-radius:50%;margin:-4px 0 0 -4px;animation:wbDot .65s ease-out forwards}
@keyframes wbDot{to{transform:translate(var(--dx),var(--dy)) scale(.2);opacity:0}}
button{transition:transform .15s ease,box-shadow .2s ease,filter .2s ease}
button:not(:disabled):active{transform:scale(.95)}
.go{animation:goPulse 2.2s ease-in-out infinite}
.go:active{animation:none}
@keyframes goPulse{0%,100%{box-shadow:0 5px 0 #9c4c00,0 0 14px #ffb00066}50%{box-shadow:0 5px 0 #9c4c00,0 0 30px #ffd54acc}}
#boardWrap{animation:boardGlow 3s ease-in-out infinite alternate}
@keyframes boardGlow{from{box-shadow:0 0 14px #00bfff44}to{box-shadow:0 0 30px #00d8ffaa,0 0 50px #5b6bff44}}
.cell{animation:cellIn .45s cubic-bezier(.2,1.3,.4,1) backwards;transition:transform .2s ease,filter .2s ease}
.cell:hover{transform:scale(1.07);filter:brightness(1.1);z-index:2}
@keyframes cellIn{from{opacity:0;transform:scale(.5)}to{opacity:1;transform:scale(1)}}
.cell.luck,.cell.replay,.cell.trap,.cell.jump{animation:cellIn .45s cubic-bezier(.2,1.3,.4,1) backwards,cellGlow 2.4s ease-in-out .6s infinite alternate}
@keyframes cellGlow{from{filter:brightness(1)}to{filter:brightness(1.18) drop-shadow(0 0 5px #fff8)}}
.tok{animation:tokBob 1.3s ease-in-out infinite alternate}
@keyframes tokBob{from{transform:translateY(0)}to{transform:translateY(-3px)}}
.n{transition:transform .15s ease,background .2s ease,box-shadow .2s ease,opacity .3s ease}
.n:not(:disabled):hover{transform:scale(1.12);box-shadow:0 0 12px #00e5ff}
.n:not(:disabled):active{transform:scale(.9)}
.n:disabled{transform:scale(.85)}
#nums .n{animation:numIn .35s ease backwards}
@keyframes numIn{from{opacity:0;transform:scale(.4)}to{opacity:1;transform:scale(1)}}
.team-pill{transition:transform .3s ease,opacity .3s ease,box-shadow .3s ease}
.team-pill.on{animation:pillPulse 1.6s ease-in-out infinite alternate}
@keyframes pillPulse{from{box-shadow:0 0 0 3px #ffdf48}to{box-shadow:0 0 0 3px #ffdf48,0 0 16px #ffdf48aa}}
#turn{animation:turnGlow 2.4s ease-in-out infinite alternate}
@keyframes turnGlow{from{box-shadow:0 0 0 #42d9ff00}to{box-shadow:0 0 16px #42d9ff88}}
.box{animation:boxIn .3s cubic-bezier(.2,1.3,.4,1) both}
